# Copy this file to .env and fill in real values. .env is gitignored.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

ENVIRONMENT=development
LOG_LEVEL=INFO

# Vector index location. Defaults to <repo>/data/chroma; a relative path here
# is resolved against the current working directory.
# CHROMA_PERSIST_DIR=

# "sentence-transformers" needs the local-embeddings extra:
#   pip install -e ".[local-embeddings]"
# "hashing" is a dependency-free lexical baseline (used by CI and tests).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
